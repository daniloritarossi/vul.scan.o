# Supabase locale — modello di supabase/.env.
#
# NON copiare questo file a mano: supabase/setup.sh crea supabase/.env al primo
# avvio con segreti casuali propri di questa installazione (gen_secrets.py).
# Ogni installazione deve avere i suoi: con segreti condivisi, chi conosce
# quelli di una copia entra nel database di tutte le altre.

# Password di tutti i ruoli Postgres con login (postgres, authenticator, ...).
POSTGRES_PASSWORD=<generata>

# Segreto con cui PostgREST verifica i JWT (hex, 64 caratteri).
JWT_SECRET=<generato>

# JWT HS256 firmati con JWT_SECRET: ruolo anon e ruolo service_role (usato dall'app).
ANON_KEY=<generata>
SERVICE_ROLE_KEY=<generata>

# Studio
DEFAULT_ORGANIZATION_NAME=Local
DEFAULT_PROJECT_NAME=VulnFeedAggregator
